worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events { worker_connections 256; }
http {
  access_log /dev/stdout;
  upstream telegram_api { server 127.0.0.1:${TELEGRAM_HTTP_PORT}; }
  upstream pdfbot_worker { server 127.0.0.1:${PDFBOT_WORKER_PORT}; }
  upstream pdfbot_app { server 127.0.0.1:${PDFBOT_APP_PORT}; }
  server {
    listen ${PORT};
    location /pdfbot/ {
      proxy_pass http://pdfbot_worker;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /api/ {
      proxy_pass http://pdfbot_app;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location = / {
      proxy_pass http://pdfbot_app/health;
      proxy_set_header Host $host;
    }
    location /health {
      proxy_pass http://pdfbot_app;
      proxy_set_header Host $host;
    }
    location /dashboard {
      proxy_pass http://pdfbot_app;
      proxy_set_header Host $host;
    }
    location / {
      proxy_pass http://telegram_api;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
  }
}
